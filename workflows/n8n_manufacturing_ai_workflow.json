    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\nconst body = item.json.body ?? item.json;\nconst binary = item.binary?.data;\nconst filename = binary?.fileName ?? '';\nconst modelId = String(body.model_id ?? '').trim();\nconst warning = Number(body.warning_threshold ?? 95);\nconst danger = Number(body.danger_threshold ?? 90);\nconst maxRows = Number(body.max_rows ?? 500);\nconst topN = Number(body.top_n ?? 20);\nconst perWaferTopN = Number(body.per_wafer_top_n ?? 5);\nlet error = '';\nif (!binary) error = 'binary.data CSV 파일이 필요합니다.';\nelse if (!filename.toLowerCase().endsWith('.csv')) error = 'CSV(.csv) 파일만 전송할 수 있습니다.';\nelse if (!modelId) error = 'model_id가 필요합니다.';\nelse if (![warning, danger, maxRows, topN, perWaferTopN].every(Number.isFinite)) error = 'threshold와 분석 옵션은 숫자여야 합니다.';\nelse if (warning <= danger) error = 'warning_threshold는 danger_threshold보다 커야 합니다.';\nelse if (maxRows < 1 || maxRows > 1000) error = 'max_rows는 1부터 1000 사이여야 합니다.';\nelse if (topN < 1 || topN > 100) error = 'top_n은 1부터 100 사이여야 합니다.';\nreturn [{ json: { valid: !error, error, error_type: 'validation_error', model_id: modelId, warning_threshold: warning, danger_threshold: danger, max_rows: maxRows, top_n: topN, per_wafer_top_n: perWaferTopN, include_report: body.include_report ?? true }, binary: item.binary }];"
      },
      "id": "validate-input-code",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "input-valid-condition",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "input-valid-if",
      "name": "Input Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
