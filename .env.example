APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MODEL_DIR=models
MAX_UPLOAD_SIZE_MB=20
LOG_LEVEL=INFO
RUNTIME_DB_PATH=data/runtime/dashboard.db
RUNTIME_ARTIFACT_DIR=data/runtime
TRAINING_JOB_ARTIFACT_DIR=data/runtime/training_jobs

# SUNI 챗봇 LLM 연결 (Upstage, OpenAI 호환). 키는 Railway 환경변수로만 관리하고
# 절대 프런트에 노출하지 않는다 (NEXT_PUBLIC_ 접두사 금지).
# 로컬 개발: 이 파일을 .env 로 복사하고 키를 채운다.
# 배포(Railway): 이 파일 대신 서비스 Variables 에 등록한다.
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_MODEL=solar-pro3

# 알림 연동(Slack/Telegram/Gmail, 알람 알림 연동 기능). 전부 선택값이며
# 비워두면 해당 채널은 UI에서 "연결하기"를 눌러도 실제로는 발송되지 않는다.
# Slack은 사용자가 설정 패널에서 직접 Webhook URL을 입력해 연결하므로 여기
# env var로 두지 않는다(RuntimeStore에 저장, api/settings.py 참고).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
NOTIFY_VERIFY_BASE_URL=

# 자동 수집 파이프라인 1단계 (감시 디렉터리 폴링, src/automation/ingest.py).
# 주기는 여기 두지 않는다 -- 모델 학습·자동화 팝업에서 저장한
# refreshIntervalMinutes를 스케줄러가 그대로 따른다.
AUTO_INGEST_DIR=
AUTO_INGEST_ENABLED=false

# Railway Volume을 /data에 연결한 Production 예시입니다.
# RAILWAY_VOLUME_MOUNT_PATH는 Volume 연결 시 Railway가 자동 제공합니다.
# Volume은 영구 저장소이며 RAM을 대체하지 않습니다.
# MODEL_DIR=/data/models
# RUNTIME_DB_PATH=/data/runtime.db
# RUNTIME_ARTIFACT_DIR=/data/artifacts
# TRAINING_JOB_ARTIFACT_DIR=/data/artifacts/training_jobs
