NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# Server-only values used by the Next.js admin reset proxy.
# Never rename ADMIN_RESET_SECRET with a NEXT_PUBLIC_ prefix.
BACKEND_API_BASE_URL=http://127.0.0.1:8000
ADMIN_RESET_SECRET=

# Production examples (set these in Vercel, not in .env.local):
# NEXT_PUBLIC_API_BASE_URL=https://your-api.onrender.com
# NEXT_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n.example/webhook/manufacturing-ai-analysis
# BACKEND_API_BASE_URL=https://your-api.onrender.com
# ADMIN_RESET_SECRET=replace-with-a-long-random-server-only-secret
